        <mxCell id="jellw08YbjSvtvO56Pm3-32" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;h3&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Detalle del caso de uso: Registrar una suscripción&lt;/font&gt;&lt;/h3&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;&lt;strong&gt;Actor:&lt;/strong&gt; Usuario&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;&lt;strong&gt;Objetivo:&lt;/strong&gt; Registrar una nueva suscripción para llevar el control de su costo y próximo cobro.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;&lt;strong&gt;Precondición:&lt;/strong&gt; El usuario debe haber accedido al sistema.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;font size=&quot;3&quot;&gt;Escenario principal:&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;ol start=&quot;1&quot;&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;El usuario selecciona la opción para registrar una suscripción.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;El sistema muestra los campos de registro.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;El usuario ingresa el nombre del servicio.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;El usuario ingresa el costo de la suscripción.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;El usuario selecciona la frecuencia de pago.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;El usuario ingresa la fecha del próximo cobro.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;El usuario confirma el registro.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;El sistema valida la información.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;El sistema registra la suscripción.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;El sistema muestra la suscripción registrada.&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;strong&gt;&lt;font size=&quot;3&quot;&gt;Flujo alterno 1 — Datos incompletos:&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;Si falta alguno de los campos obligatorios, el sistema no registra la suscripción.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;El sistema indica que deben completarse los datos faltantes.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;El usuario puede completar la información y volver a confirmar.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;&lt;font size=&quot;3&quot;&gt;Flujo alterno 2 — Costo no válido:&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;Si el costo ingresado es igual o menor a cero, el sistema no registra la suscripción.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;El sistema solicita ingresar un costo mayor a cero.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;El usuario corrige el costo y vuelve a confirmar.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;&lt;strong&gt;Postcondición:&lt;/strong&gt; La suscripción queda registrada y disponible para ser consultada por el usuario.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;&lt;strong&gt;Requisito funcional relacionado:&lt;/strong&gt; RF-001 — Registrar una suscripción.&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="420" width="670" x="1680" y="400" as="geometry" />
        </mxCell>
